# Copy to .env.local. That file is git-ignored; never commit real keys.

# Fal — pay-as-you-go video. https://fal.ai/dashboard/keys
# Leave empty and Lumen still runs: Proof mode renders real assets for free.
FAL_KEY=

# Direct OpenAI images. The model and its cost are explicit so Lumen never
# silently swaps models or shows an invented price.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_COST_USD=0
